<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.khoipm.nvme-sentinel</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/nvme-sentinel-daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/tmp/nvme-sentinel-daemon.err</string>
    <key>StandardOutPath</key>
    <string>/tmp/nvme-sentinel-daemon.out</string>
</dict>
</plist>
